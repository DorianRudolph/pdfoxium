<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/"><subform name="demo" layout="position"><pageSet><pageArea name="page"><occur min="1" max="1"/><medium short="612pt" long="792pt"/><contentArea x="36pt" y="36pt" w="540pt" h="720pt"/></pageArea></pageSet>
<draw x="0pt" y="0pt" w="500pt" h="40pt"><font typeface="Helvetica" size="24pt"/><value><text>Interactive XFA form</text></value></draw>
<draw x="0pt" y="42pt" w="500pt" h="22pt"><font typeface="Helvetica" size="11pt"/><value><text>Real XFA controls, layout, data binding and JavaScript.</text></value></draw>
<field name="customer" x="0pt" y="85pt" w="360pt" h="50pt"><font typeface="Helvetica" size="12pt"/><ui><textEdit/></ui><caption placement="top" reserve="18pt"><font typeface="Helvetica" size="10pt"/><value><text>Customer name</text></value></caption><border><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$record.customer"/><value><text>Ada Lovelace</text></value></field><field name="email" x="0pt" y="155pt" w="360pt" h="50pt"><font typeface="Helvetica" size="12pt"/><ui><textEdit/></ui><caption placement="top" reserve="18pt"><font typeface="Helvetica" size="10pt"/><value><text>Email</text></value></caption><border><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$record.email"/><value><text>ada@demo.test</text></value></field><field name="quantity" x="0pt" y="225pt" w="150pt" h="50pt"><font typeface="Helvetica" size="12pt"/><ui><numericEdit/></ui><caption placement="top" reserve="18pt"><font typeface="Helvetica" size="10pt"/><value><text>Quantity</text></value></caption><border><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$record.quantity"/><value><text>2</text></value></field><field name="delivery" x="190pt" y="225pt" w="220pt" h="50pt"><font typeface="Helvetica" size="12pt"/><ui><choiceList open="userControl"/></ui><caption placement="top" reserve="18pt"><font typeface="Helvetica" size="10pt"/><value><text>Delivery</text></value></caption><border><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$record.delivery"/><value><text>Standard</text></value><items><text>Standard</text><text>Express</text></items></field><field name="notes" x="0pt" y="305pt" w="480pt" h="110pt"><font typeface="Helvetica" size="12pt"/><ui><textEdit multiLine="1"/></ui><caption placement="top" reserve="18pt"><font typeface="Helvetica" size="10pt"/><value><text>Notes (multiline)</text></value></caption><border><edge thickness="0.75pt"/></border><bind match="dataRef" ref="$record.notes"/><value><text>Try editing this XFA field.</text></val